{
  "extends": "../../tsconfig.base.json",
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.spec.json" }],
  "compilerOptions": {
    "composite": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "moduleResolution": "Bundler",
    "lib": ["es2023"],
    "types": ["node", "vitest/globals", "vitest/importMeta", "vitest"],
    "paths": {
      "@backend/*": ["./src/*"],
      "@prisma/client": ["./src/db/postgres/generated/client"]
    }
  },
  "include": ["./global.d.ts"],
  "exclude": ["node_modules", "dist", "out-tsc", "exported"]
}
