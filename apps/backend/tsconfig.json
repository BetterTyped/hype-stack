{
  "compilerOptions": {
    "composite": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "moduleResolution": "Bundler",
    "lib": ["es2023"],
    "types": ["node", "vitest/globals", "vitest/importMeta", "vitest"],
    "paths": {
      "@backend/*": ["./src/*"],
      "@prisma/client": ["./src/db/postgres/generated/client"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "./global.d.ts", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "out-tsc", "exported"],
  "extends": "../../tsconfig.base.json"
}
