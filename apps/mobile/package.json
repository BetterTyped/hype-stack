{
  "name": "@hype-stack/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "serve": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export",
    "native:prebuild": "expo prebuild",
    "format": "pnpm --dir ../.. exec oxfmt --write apps/mobile",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --dir ../.. exec oxlint --fix apps/mobile",
    "test": "vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@hype-stack/backend": "workspace:*",
    "@hype-stack/enums": "workspace:*",
    "@hyper-fetch/core": "^8.1.1",
    "@hyper-fetch/react": "^8.1.1",
    "@hyper-fetch/sockets": "^8.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/accordion": "^1.5.2",
    "@rn-primitives/alert-dialog": "^1.5.2",
    "@rn-primitives/aspect-ratio": "^1.5.2",
    "@rn-primitives/avatar": "^1.5.2",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/collapsible": "^1.5.2",
    "@rn-primitives/context-menu": "^1.5.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/hover-card": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/menubar": "^1.5.2",
    "@rn-primitives/popover": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/progress": "^1.5.2",
    "@rn-primitives/radio-group": "^1.5.2",
    "@rn-primitives/select": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "@rn-primitives/tabs": "^1.5.2",
    "@rn-primitives/toggle": "^1.5.2",
    "@rn-primitives/toggle-group": "^1.5.2",
    "@rn-primitives/tooltip": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~56.0.19",
    "expo-constants": "~56.0.19",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.12",
    "expo-splash-screen": "~56.0.11",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "lucide-react-native": "^1.21.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/babel-preset": "^0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "19.2.14",
    "react-test-renderer": "19.2.3",
    "vite": "8.0.10",
    "vitest": "^4.1.5",
    "vitest-native": "^0.9.0"
  },
  "nx": {
    "targets": {
      "serve": {
        "continuous": true,
        "dependsOn": [
          "^build"
        ]
      },
      "build": {
        "dependsOn": [
          "^build"
        ]
      },
      "test": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
